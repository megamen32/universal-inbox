# Root-owned operator configuration. Install as /etc/universal-inbox.env (0600).
UNIVERSAL_INBOX_DB_PATH=/var/lib/universal-inbox/inbox.sqlite3
UNIVERSAL_INBOX_WEBHOOK_HOST=127.0.0.1
UNIVERSAL_INBOX_WEBHOOK_PORT=18092
UNIVERSAL_INBOX_WEBHOOK_TOKEN=replace-with-random-ingress-token
UNIVERSAL_INBOX_NOTICEPLACE_EVENT_URL=http://127.0.0.1:8091/v1/events
UNIVERSAL_INBOX_NOTICEPLACE_ROUTES_JSON={"telegram":{"token":"replace-with-telegram-consumer-token"},"matrix":{"token":"replace-with-matrix-consumer-token"}}

# Matrix reader identity; this account must not be the NoticePlace Matrix sender.
UNIVERSAL_INBOX_MATRIX_HOMESERVER=https://matrix.example
UNIVERSAL_INBOX_MATRIX_ACCESS_TOKEN=replace-with-dedicated-reader-token
UNIVERSAL_INBOX_MATRIX_USER_ID=@inbox-reader:matrix.example
UNIVERSAL_INBOX_MATRIX_ROOM_IDS=!operator-room:matrix.example
UNIVERSAL_INBOX_POLL_INTERVAL_SECONDS=5
