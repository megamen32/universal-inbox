[Unit]
Description=Universal Inbox WhatsApp QR connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roomhacker
WorkingDirectory=/opt/universal-inbox-whatsapp-qr
Environment=PORT=18096
Environment=PUBLIC_PREFIX=/whatsapp-qr
Environment=UNIVERSAL_USERIO_URL=http://127.0.0.1:18093
EnvironmentFile=/etc/universal-userio.env
ExecStart=/usr/bin/node /opt/universal-inbox-whatsapp-qr/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
